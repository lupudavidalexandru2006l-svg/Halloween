export type Clip = { s: number, loop: boolean, mirror: number, spin: boolean?, autoLegs: boolean?, cycle: boolean?, swing: number?,
	tracks: { [string]: { [string]: { number } } } }

-- the clip a pet of this plan plays for `name` (its plan's own walk / run / sleep, else the shared one)
function PetClips.get(plan: string, name: string): Clip?
	local p = PetClips.plans[plan]
	return (p and p[name]) or PetClips.common[name] or nil
end

-- cubic Catmull-Rom through flat {t, v, ...} keys at t (0..1); loops wrap, one-shots hold their ends
local function catmull(k: { number }, t: number, loop: boolean): number
	local n = #k // 2
	if n == 1 then
		return k[2]
	end
	if loop then
		t = t % 1
	end
	if t <= k[1] then
		return k[2]
	end
	if t >= k[2 * n - 1] then
		return k[2 * n]
	end
	local i = 1 -- key index (1-based): segment between key i and i + 1
	while i < n - 1 and t > k[2 * (i + 1) - 1] do
		i += 1
	end
	local t0, v0 = k[2 * i - 1], k[2 * i]
	local t1, v1 = k[2 * i + 1], k[2 * i + 2]
	local tm, pm, tp, pp
	if i > 1 then
		tm, pm = k[2 * i - 3], k[2 * i - 2]
	elseif loop then
		tm, pm = k[2 * (n - 1) - 1] - 1, k[2 * (n - 1)]
	else
		tm, pm = t0 - (t1 - t0), v0
	end
	if i + 2 <= n then
		tp, pp = k[2 * i + 3], k[2 * i + 4]
	elseif loop then
		tp, pp = k[3] + 1, k[4]
	else
		tp, pp = t1 + (t1 - t0), v1
	end
	local span = math.max(t1 - t0, 1e-6)
	local u = (t - t0) / span
	local m0 = (v1 - pm) / math.max(t1 - tm, 1e-6) * span
	local m1 = (pp - v0) / math.max(tp - t0, 1e-6) * span
	local u2, u3 = u * u, u * u * u
	return (2 * u3 - 3 * u2 + 1) * v0 + (u3 - 2 * u2 + u) * m0 + (-2 * u3 + 3 * u2) * v1 + (u3 - u2) * m1
end
PetClips.catmull = catmull

-- adds w x (one slot's channels at clip time t) into `into`; right side mirrors (yw, rl, rt flip; `mirror` later)
function PetClips.addSlot(into: { [string]: number }, clip: Clip, slot: string, right: boolean, t: number, w: number, damp: number?)
	local tr = clip.tracks[slot]
	if not tr or w <= 0 then
		return
	end
	local tt = t
	if right and clip.mirror ~= 0 then
		tt = t - clip.mirror
		if not clip.loop then
			tt = math.max(0, tt)
		end
	end
	local f = damp or 1
	for ch, keys in tr do
		local v = catmull(keys, tt, clip.loop)
		if right and (ch == "yw" or ch == "rl" or ch == "rt") then
			v = -v
		end
		if ch == "px" or ch == "yw" or ch == "rl" then
			v *= f
		elseif ch == "sink" and slot == "root" then
			v *= f
		end
		into[ch] = (into[ch] or 0) + v * w
	end
end

-- two-bone fold so a straight-down leg's foot rises by `drop` studs: (upper, lower) in degrees
function PetClips.legFold(drop: number, L1: number, L2: number): (number, number)
	local d0 = L1 + L2
	local d = math.clamp(d0 - math.max(0, drop), 0.25 * d0, d0)
	local c = math.clamp((d * d - L1 * L1 - L2 * L2) / (2 * L1 * L2), -1, 1)
	local b = math.acos(c)
	local a = math.atan2(L2 * math.sin(b), L1 + L2 * math.cos(b))
	return math.deg(a), -math.deg(b)
end

return PetClips
